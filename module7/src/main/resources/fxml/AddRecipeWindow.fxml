<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #F4E4A6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipe.AddRecipeController">

    <style>
        -fx-font-family: "Georgia";
    </style>

    <!-- Recipe Name -->
    <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Recipe Name:" />
    <TextField fx:id="recipeNameField" promptText="Enter recipe name" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;" />

    <!-- Cuisine -->
    <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Cuisine:" />
    <ComboBox fx:id="cuisineComboBox" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;" />

    <!-- Times and Servings -->
    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Prep Time (min):" />
            <Spinner fx:id="prepTimeSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;" />
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Cook Time (min):" />
            <Spinner fx:id="cookTimeSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;" />
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Servings:" />
            <Spinner fx:id="servingsSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;" />
        </VBox>
    </HBox>

    <!-- Ingredients -->
    <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Ingredients:" />
    <TextArea fx:id="ingredientsArea" promptText="Enter ingredients (one per line)" style="-fx-control-inner-background: white; -fx-text-fill: #42273b; -fx-font-size: 12; -fx-padding: 5;" wrapText="true" VBox.vgrow="ALWAYS" />

    <!-- Instructions -->
    <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Instructions:" />
    <TextArea fx:id="instructionsArea" promptText="Enter cooking instructions (one per line)" style="-fx-control-inner-background: white; -fx-text-fill: #42273b; -fx-font-size: 12; -fx-padding: 5;" wrapText="true" VBox.vgrow="ALWAYS" />

    <!-- Image Upload -->
    <Label style="-fx-text-fill: #42273b; -fx-font-weight: bold;" text="Recipe Image:" />
    <HBox prefHeight="35.0" prefWidth="499.0" spacing="10">
        <Button fx:id="uploadImageBtn" onAction="#uploadImage" prefHeight="26.0" prefWidth="209.0" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold;" text="Upload Image" />
        <Label fx:id="imagePathLabel" style="-fx-text-fill: #42273b;" text="No image selected" />
    </HBox>

    <!-- Buttons -->
    <HBox prefHeight="57.0" prefWidth="365.0" spacing="10" style="-fx-padding: 10, 0, 0, 0;">
        <Button fx:id="saveRecipeBtn" onAction="#saveRecipe" prefHeight="37.0" prefWidth="133.0" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold; -fx-padding: 10;" text="Save Recipe" HBox.hgrow="ALWAYS" />
        <Button fx:id="cancelBtn" onAction="#cancel" prefHeight="37.0" prefWidth="88.0" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold; -fx-padding: 10;" text="Cancel" HBox.hgrow="ALWAYS" />
    </HBox>

</VBox>
