<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipe.AddRecipeController" spacing="10" style="-fx-padding: 15; -fx-background-color: #F4E4A6;">

    <style>
        -fx-font-family: "Georgia";
    </style>

    <!-- Recipe Name -->
    <Label text="Recipe Name:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
    <TextField fx:id="recipeNameField" promptText="Enter recipe name" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;"/>

    <!-- Cuisine -->
    <Label text="Cuisine:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
    <ComboBox fx:id="cuisineComboBox" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;"/>

    <!-- Times and Servings -->
    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Prep Time (min):" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
            <Spinner fx:id="prepTimeSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Cook Time (min):" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
            <Spinner fx:id="cookTimeSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Servings:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
            <Spinner fx:id="servingsSpinner" style="-fx-control-inner-background: white; -fx-text-fill: #42273b;"/>
        </VBox>
    </HBox>

    <!-- Ingredients -->
    <Label text="Ingredients:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
    <TextArea fx:id="ingredientsArea" wrapText="true" promptText="Enter ingredients (one per line)" style="-fx-control-inner-background: white; -fx-text-fill: #42273b; -fx-font-size: 12; -fx-padding: 5;" VBox.vgrow="ALWAYS"/>

    <!-- Instructions -->
    <Label text="Instructions:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
    <TextArea fx:id="instructionsArea" wrapText="true" promptText="Enter cooking instructions (one per line)" style="-fx-control-inner-background: white; -fx-text-fill: #42273b; -fx-font-size: 12; -fx-padding: 5;" VBox.vgrow="ALWAYS"/>

    <!-- Image Upload -->
    <Label text="Recipe Image:" style="-fx-text-fill: #42273b; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <Button fx:id="uploadImageBtn" text="Upload Image" onAction="#uploadImage" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold;"/>
        <Label fx:id="imagePathLabel" text="No image selected" style="-fx-text-fill: #42273b;"/>
    </HBox>

    <!-- Buttons -->
    <HBox spacing="10" style="-fx-padding: 10, 0, 0, 0;">
        <Button fx:id="saveRecipeBtn" text="Save Recipe" onAction="#saveRecipe" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold; -fx-padding: 10;" HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelBtn" text="Cancel" onAction="#cancel" style="-fx-background-color: #c4d7f2; -fx-text-fill: #42273b; -fx-font-weight: bold; -fx-padding: 10;" HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>
