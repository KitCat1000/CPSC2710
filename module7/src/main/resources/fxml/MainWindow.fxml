<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.recipe.RecipeController">
   <top>
      <VBox prefHeight="80.0" prefWidth="1000.0" spacing="5.0" style="-fx-background-color: #1B5E20; -fx-padding: 15;">
         <Label text="🏺 Recipe Vault" style="-fx-text-fill: #FFD700; -fx-font-size: 28; -fx-font-weight: bold; -fx-font-family: 'Georgia';" />
         <Label text="Your Collection of Culinary Treasures" style="-fx-text-fill: #C9A961; -fx-font-size: 12; -fx-font-style: italic;" />
         <HBox spacing="10.0">
            <MenuBar style="-fx-background-color: #2C2416;" prefWidth="1000.0">
               <menus>
                  <Menu text="File">
                     <MenuItem text="Exit" onAction="#exitApplication" accelerator="SHORTCUT+Q" />
                  </Menu>
                  <Menu text="Recipe">
                     <MenuItem text="Add Recipe" onAction="#openAddRecipeWindow" accelerator="SHORTCUT+N" />
                     <MenuItem text="Edit Recipe" onAction="#openEditRecipeWindow" accelerator="SHORTCUT+E" />
                     <MenuItem text="Delete Recipe" onAction="#deleteRecipe" accelerator="DELETE" />
                  </Menu>
               </menus>
            </MenuBar>
         </HBox>
      </VBox>
   </top>
   <left>
      <VBox prefHeight="640.0" prefWidth="300.0" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #1B5E20;">
         <Label text="Search & Filter" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #FFD700;" />
         <TextField fx:id="searchField" promptText="Search recipes..." />
         <Label text="Filter by Cuisine:" style="-fx-text-fill: #FFD700; -fx-font-weight: bold;" />
         <ComboBox fx:id="cuisineFilterComboBox" prefWidth="280.0" />
         <Separator />
         <Label text="Your Recipes" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #FFD700;" />
         <ListView fx:id="recipeListView" prefHeight="400.0" prefWidth="280.0" />
         <HBox spacing="8.0">
            <Button fx:id="addRecipeBtn" text="➕ Add" onAction="#openAddRecipeWindow" prefWidth="85.0" />
            <Button fx:id="editRecipeBtn" text="✏️ Edit" onAction="#openEditRecipeWindow" prefWidth="85.0" />
            <Button fx:id="deleteRecipeBtn" text="🗑️ Delete" onAction="#deleteRecipe" prefWidth="85.0" />
         </HBox>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="640.0" prefWidth="700.0" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #F4E4A6;">
         <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label fx:id="recipeTitleLabel" text="Select a recipe to view details" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1B5E20;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" style="-fx-text-fill: #4CAF50; -fx-font-size: 11;" />
         </HBox>
         <Separator />
         <HBox spacing="15.0" prefHeight="200.0">
            <VBox prefWidth="300.0" spacing="5.0">
               <Label text="Recipe Image" style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1B5E20;" />
               <ImageView fx:id="recipeImageView" fitHeight="180.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
            </VBox>
            <TextArea fx:id="recipeDetailsArea" prefHeight="200.0" prefWidth="400.0" wrapText="true" editable="false" />
         </HBox>
         <Separator />
         <TextArea prefHeight="150.0" promptText="Recipe details will appear here..." wrapText="true" editable="false" />
      </VBox>
   </center>
</BorderPane>
