<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.airport.AirportViewController">
    <top>
        <Label text="Nicole Tressler's Airport Mapview App" BorderPane.alignment="CENTER">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
    </top>
    <left>
        <VBox fx:id="nameField" opacity="0.95" prefHeight="200.0" prefWidth="350.0" spacing="5.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" />
            </padding>
            <children>
                <Label text="Search Fields">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <HBox prefHeight="33.0" prefWidth="350.0" spacing="5.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="Ident:" />
                        <TextField id="identField" fx:id="identField" />
                    </children>
                </HBox>
                <HBox prefHeight="33.0" prefWidth="350.0" spacing="5.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="IATA Code:" />
                        <TextField id="iataCodeField" fx:id="iataCodeField" prefHeight="25.0" prefWidth="160.0" />
                    </children>
                </HBox>
                <HBox prefHeight="47.0" prefWidth="350.0" spacing="5.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="Local Code:" />
                        <TextField id="localCodeField" fx:id="localCodeField" />
                    </children>
                </HBox>
                <Button id="searchButton" fx:id="searchButton" mnemonicParsing="false" prefHeight="29.0" prefWidth="79.0" text="Search" />
                <Label text="Airport Information">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <HBox fx:id="typeField" prefHeight="36.0" prefWidth="350.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="67.0" text="Type:" />
                        <TextField fx:id="textField" editable="false" prefHeight="26.0" prefWidth="218.0" />
                    </children>
                </HBox>
                <HBox fx:id="nameField" prefHeight="35.0" prefWidth="237.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="68.0" text="Name:" />
                        <TextField fx:id="nameField" editable="false" prefHeight="26.0" prefWidth="218.0" />
                    </children>
                </HBox>
                <HBox fx:id="elevationField" prefHeight="36.0" prefWidth="350.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="67.0" text="Elevation:" />
                        <TextField fx:id="elevationField" editable="false" prefHeight="26.0" prefWidth="219.0" />
                    </children>
                </HBox>
                <HBox prefHeight="37.0" prefWidth="350.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="68.0" text="Country:" />
                        <TextField fx:id="countryField" editable="false" prefHeight="26.0" prefWidth="218.0" />
                    </children>
                </HBox>
                <HBox fx:id="countryField" prefHeight="44.0" prefWidth="350.0">
                    <children>
                        <Label prefHeight="17.0" prefWidth="69.0" text="Region:" />
                        <TextField fx:id="regionField" editable="false" prefHeight="26.0" prefWidth="218.0" />
                    </children>
                </HBox>
                <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Municipality:" />
                        <TextField fx:id="municipalityField" editable="false" prefHeight="26.0" prefWidth="217.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <WebView fx:id="mapView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
